{
  "manifest_version": 3,
  "name": "Telemetry Monitor - Space Dogs",
  "version": "1.0",
  "description": "Real-time telemetry dashboard for the Space Dogs API running on localhost.",
  "minimum_chrome_version": "102",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Space Dogs Telemetry"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },

  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ]
}